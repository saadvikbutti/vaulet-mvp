# SQLite for local dev (zero setup). To move to Postgres, change the
# provider in prisma/schema.prisma to "postgresql" and put a real
# connection string here (e.g. from Neon, Railway, or Supabase Postgres).
DATABASE_URL="file:./dev.db"

# Any long random string — used to sign session JWTs.
JWT_SECRET="replace-with-a-long-random-string"

# Optional: if set, /api/planner calls Anthropic instead of returning a
# mocked plan. Keep this server-side only — never exposed to the client.
ANTHROPIC_API_KEY=""
