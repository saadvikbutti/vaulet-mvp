// Vaulet — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime @default(now())

  vauletsOwned Vaulet[]       @relation("VauletCreator")
  memberships  VauletMember[]
  transactions Transaction[]
  memories     Memory[]
}

model Vaulet {
  id          String   @id @default(cuid())
  name        String
  description String?
  currency    String   @default("INR")
  budget      Float?
  createdById String
  createdBy   User     @relation("VauletCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  members      VauletMember[]
  transactions Transaction[]
  memories     Memory[]
}

model VauletMember {
  id       String   @id @default(cuid())
  vauletId String
  vaulet   Vaulet   @relation(fields: [vauletId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([vauletId, userId])
}

model Transaction {
  id          String   @id @default(cuid())
  vauletId    String
  vaulet      Vaulet   @relation(fields: [vauletId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  amount      Float
  description String?
  category    String?
  merchant    String?
  location    String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
}

model Memory {
  id        String    @id @default(cuid())
  vauletId  String
  vaulet    Vaulet    @relation(fields: [vauletId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  imageUrl  String
  caption   String?
  location  String?
  takenAt   DateTime?
  createdAt DateTime  @default(now())
}
